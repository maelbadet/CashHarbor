@page "/marches"
@attribute [Authorize]
@inherits FinancePage
@inject IMarketHistory History
@inject IPortfolio Portfolio
@inject IInstrumentSearch Search
<PageTitle>Comparer les cours · CashHarbor</PageTitle>
<header class="page-header"><div><h1>Comparer les cours<span class="accent">.</span></h1><p>Plusieurs titres d’un même type, une période et des dates communes.</p></div></header>
<nav class="scope-tabs" aria-label="Type de marché">@foreach(var type in new[]{"etf","action","crypto"}){<a class="@(MarketKind==type?"active":"")" href="@Space.Url("/marches?kind="+type)">@Label(type)</a>}</nav>
<section class="panel market-discovery"><div class="section-heading"><div><span class="eyebrow">TROUVER UN PLACEMENT</span><h2>Rechercher par son nom</h2><p>Pas besoin de connaître son code de cotation.</p></div><span class="tag">@Label(MarketKind)</span></div>
<form method="get" class="market-search"><SpaceField /><input name="kind" type="hidden" value="@MarketKind" /><input name="one" type="hidden" value="@One" /><input name="two" type="hidden" value="@Two" /><input name="three" type="hidden" value="@Three" /><input name="mode" type="hidden" value="@Mode" /><input name="from" type="hidden" value="@Iso(FromDate)" /><input name="to" type="hidden" value="@Iso(ToDate)" /><label>Nom de l’actif<input type="search" name="search" value="@SearchTerm" maxlength="80" minlength="2" placeholder="@(MarketKind=="crypto"?"Ex. Ethereum, Bitcoin…":MarketKind=="action"?"Ex. Apple, Microsoft…":"Ex. Amundi, S&P 500…")" required /></label><button>Rechercher</button></form>
@if(Results.Count>0){<p class="market-result-count">@Results.Count résultat(s) · choisissez les titres dans les listes ci-dessous.</p><div class="market-results">@foreach(var instrument in Results){<article><span class="market-monogram">@instrument.Name[..1]</span><div><strong>@instrument.Name</strong><small>@instrument.Symbol · @instrument.Market · @instrument.Currency</small></div>@if(IsChosen(instrument.Id)){<span class="tag">Sélectionné</span>}else if(!SelectionFull){<a class="market-add" href="@ChooseUrl(instrument.Id)" aria-label="@("Comparer " + instrument.Name)">＋ Ajouter</a>}</article>}</div>}
</section>
<section class="panel market-selection"><div class="section-heading"><div><span class="eyebrow">MA COMPARAISON</span><h2>Choisir les courbes</h2><p>Jusqu’à trois @Label(MarketKind).ToLowerInvariant(), sans mélange de types.</p></div></div><form method="get" class="form-grid"><SpaceField /><input name="kind" type="hidden" value="@MarketKind" /><input name="search" type="hidden" value="@SearchTerm" />
@foreach(var slot in new[]{("one",One,"Actif principal"),("two",Two,"Comparer avec"),("three",Three,"Ajouter une comparaison")}){<label>@slot.Item3<select name="@slot.Item1"><option value="">Choisir un actif</option>@foreach(var instrument in Choices){<option value="@instrument.Id" selected="@(slot.Item2==instrument.Id)">@instrument.Name · @instrument.Symbol @(string.IsNullOrEmpty(instrument.Currency)?"":"· "+instrument.Currency) · @instrument.Market</option>}</select></label>}
<label>Du<input name="from" type="date" value="@Iso(FromDate)" min="1900-01-01" max="@Iso(Today)" required /></label><label>Au<input name="to" type="date" value="@Iso(ToDate)" min="1900-01-01" max="@Iso(Today)" required /></label><label>Comparer les<select name="mode"><option value="price" selected="@(Mode!="base100")">Prix unitaires</option><option value="base100" selected="@(Mode=="base100")">Variations · départ à 100</option></select></label><div class="form-actions"><button>Afficher ma comparaison</button></div></form>
@if(Choices.Count==0){<p class="notice neutral">Recherchez un nom ci-dessus pour remplir les listes, ou ajoutez vos placements à votre portefeuille.</p>}
<details class="market-method"><summary>Comprendre les données et les devises</summary><p>@(MarketKind=="crypto"?"Prix en EUR, points quotidiens UTC via CoinGecko. L’historique gratuit est limité à un an.":"Clôtures mensuelles Alpha Vantage, non ajustées. Les dividendes et divisions de titres peuvent affecter les courbes. Une clé API et une couverture du titre sont nécessaires.")</p><p>Le mode départ à 100 compare les variations dans la devise de chaque actif. Il ne convertit pas les devises et ne calcule pas un rendement total.</p></details></section>
<div class="market-periods" aria-label="Périodes rapides">@foreach(var period in new[]{(1,"1 mois"),(3,"3 mois"),(6,"6 mois"),(12,"1 an"),(24,"2 ans"),(60,"5 ans")}){<a href="@PeriodUrl(period.Item1)">@period.Item2</a>}</div>
@foreach(var message in Messages){<p class="notice neutral">@message</p>}
@if(Dates.Length>1 && Series.Count>0){<section class="panel"><div class="section-heading"><div><span class="eyebrow">@Label(MarketKind).ToUpperInvariant()</span><h2>@(Mode=="base100"?"Évolution en base 100":"Historique des prix")</h2></div><span class="tag">@Unit</span></div><TimeSeriesChart Dates="Dates" Series="Series" Unit="@Unit" Title="@("Comparaison historique · " + Unit)" AxisNote="Seules les dates présentes pour tous les titres retenus sont utilisées ; aucun cours manquant n’est inventé." /><p>@(Mode=="base100"?"Chaque titre vaut 100 à la première date commune. Cette vue compare les variations dans leurs devises respectives, sans conversion de change ni réinvestissement des dividendes.":"Un prix unitaire ne représente pas la performance ni la valeur de votre portefeuille.")</p><ul>@foreach(var h in Histories){<li>@h.Symbol · @h.Currency · @h.Source · dernier point @h.Prices[^1].Date.ToString("dd/MM/yyyy")</li>}</ul></section>}
@code {
[SupplyParameterFromQuery(Name="kind")]public string? MarketKind{get;set;}
[SupplyParameterFromQuery(Name="one")]public string? One{get;set;}
[SupplyParameterFromQuery(Name="two")]public string? Two{get;set;}
[SupplyParameterFromQuery(Name="three")]public string? Three{get;set;}
[SupplyParameterFromQuery(Name="from")]public string? From{get;set;}
[SupplyParameterFromQuery(Name="to")]public string? To{get;set;}
[SupplyParameterFromQuery(Name="mode")]public string? Mode{get;set;}
[SupplyParameterFromQuery(Name="search")]public string? SearchTerm{get;set;}
private List<MarketInstrument> Choices=[];
private bool IsChosen(string id)=>new[]{One,Two,Three}.Contains(id);
private bool SelectionFull=>new[]{One,Two,Three}.All(s=>!string.IsNullOrWhiteSpace(s));
private string ChooseUrl(string id)
{
    var selected=new[]{One,Two,Three};var slot=Array.FindIndex(selected,s=>string.IsNullOrWhiteSpace(s));if(slot>=0)selected[slot]=id;
    return Space.Url("/marches?kind="+MarketKind+"&one="+Uri.EscapeDataString(selected[0]??"")+"&two="+Uri.EscapeDataString(selected[1]??"")+"&three="+Uri.EscapeDataString(selected[2]??"")+"&mode="+Mode+"&search="+Uri.EscapeDataString(SearchTerm??"")+"&from="+Iso(FromDate)+"&to="+Iso(ToDate));
}
private IReadOnlyList<MarketInstrument> Results=[];
private string InstrumentName(string id)=>Choices.FirstOrDefault(c=>c.Id==id)?.Name??id;
private string PeriodUrl(int months)=>Space.Url("/marches?kind="+MarketKind+"&one="+Uri.EscapeDataString(One??"")+"&two="+Uri.EscapeDataString(Two??"")+"&three="+Uri.EscapeDataString(Three??"")+"&mode="+Mode+"&from="+Iso(Today.AddMonths(-months))+"&to="+Iso(Today)+"&search="+Uri.EscapeDataString(SearchTerm??""));
private DateOnly FromDate,ToDate;private DateOnly[] Dates=[];private string Unit="EUR";private List<ChartSeries> Series=[];private List<PriceHistory> Histories=[];private List<string> Messages=[];private string[] Symbols=[];
private static string Label(string? type)=>type=="crypto"?"Cryptos":type=="action"?"Actions":"ETF";
protected override async Task OnInitializedAsync(){
 await base.OnInitializedAsync();MarketKind=MarketKind is "crypto" or "action" or "etf"?MarketKind:"etf";Mode=Mode=="base100"?Mode:"price";
 FromDate=DateOnly.TryParseExact(From,"yyyy-MM-dd",out var start)?start:Today.AddMonths(-6);ToDate=DateOnly.TryParseExact(To,"yyyy-MM-dd",out var end)?end:Today;
 Symbols=(await Portfolio.ReadAsync(Actor,Space.IsCouple)).Where(h=>h.Kind==MarketKind).Select(h=>h.Symbol).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
 var holdings=(await Portfolio.ReadAsync(Actor,Space.IsCouple)).Where(h=>h.Kind==MarketKind).ToArray();
 Choices.AddRange(holdings.Select(h=>new MarketInstrument(h.Symbol,h.Name,h.Symbol,"","Mon portefeuille")));
 if(MarketKind=="crypto")Choices.AddRange(new[]{new MarketInstrument("bitcoin","Bitcoin","BTC","EUR","Crypto"),new("ethereum","Ethereum","ETH","EUR","Crypto"),new("solana","Solana","SOL","EUR","Crypto")});
 if(!string.IsNullOrWhiteSpace(SearchTerm)){Results=await Search.SearchAsync(MarketKind,SearchTerm);Choices.AddRange(Results);if(Results.Count==0)Messages.Add("Aucun résultat disponible. Essayez un nom plus précis ; pour les actions et ETF, vérifiez aussi la clé API, sa couverture et son quota.");}
 Choices=Choices.DistinctBy(c=>c.Id).ToList();foreach(var selected in new[]{One,Two,Three}.Where(s=>!string.IsNullOrWhiteSpace(s)))if(!Choices.Any(c=>c.Id==selected))Choices.Add(new(selected!,selected!,selected!,"","Sélection conservée"));
 if(FromDate.Year<1900||ToDate>Today||FromDate>=ToDate||ToDate.DayNumber-FromDate.DayNumber>3660){Messages.Add("Choisissez une période passée ou courante de dix ans maximum.");return;}
 var symbols=new[]{One,Two,Three}.Where(s=>!string.IsNullOrWhiteSpace(s)).Select(s=>s!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();if(symbols.Length==0){Messages.Add("Sélectionnez jusqu’à trois titres de ce type pour tracer leurs courbes.");return;}
 var histories=await Task.WhenAll(symbols.Select(s=>History.ReadAsync(MarketKind,s,FromDate,ToDate)));
 for(var i=0;i<symbols.Length;i++){var h=histories[i];if(h==null||h.Prices.Count<2)Messages.Add(symbols[i]+" : "+(History.GetError(MarketKind,symbols[i],FromDate,ToDate)??"Moins de deux observations sur cette période. Essayez une période plus longue ; les cours actions/ETF sont mensuels."));else Histories.Add(h);}
 if(Histories.Count==0)return;
 if(Mode=="price"&&Histories.Select(h=>h.Currency).Distinct().Count()>1){Messages.Add("Ces titres sont cotés dans des devises différentes. Choisissez la base 100 pour les comparer sans conversion implicite.");return;}
 Dates=Histories.Select(h=>h.Prices.Select(p=>p.Date).ToHashSet()).Aggregate((a,b)=>{a.IntersectWith(b);return a;}).Order().ToArray();if(Dates.Length<2){Messages.Add("Pas assez de dates communes : essayez une autre période ou moins de titres.");return;}
 Unit=Mode=="base100"?"base 100":Histories[0].Currency;
 for(var i=0;i<Histories.Count;i++){var h=Histories[i];var lookup=h.Prices.ToDictionary(p=>p.Date,p=>p.Price);var baseline=lookup[Dates[0]];var values=Dates.Select(d=>Mode=="base100"?lookup[d]/baseline*100:lookup[d]).ToArray();if(values.Any(v=>v>long.MaxValue/100m)){Messages.Add(h.Symbol+" : valeurs trop élevées pour le graphique.");continue;}Series.Add(new(InstrumentName(h.Symbol),values.Select(v=>(long)decimal.Round(v*100)).ToArray(),i==0?"series-total":i==1?"series-personal":"series-joint"));}
}
}
