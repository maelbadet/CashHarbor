@page "/projection"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Projection de mon épargne · CashHarbor</PageTitle>
<header class="page-header"><div><h1>Et si j’épargnais chaque mois<span class="accent"> ?</span></h1><p>Durée libre de 1 à 60 ans, intérêts composés et scénarios comparés.</p></div></header>
<Notice />
<section class="panel"><h2>Utiliser la médiane historique d’un ETF ou d’une action</h2><form method="post" action="/projection/history" class="filters"><AntiforgeryToken /><SpaceField /><label>Symbole exact Alpha Vantage<input name="symbol" maxlength="50" required placeholder="Symbole de votre part et de sa place de cotation" /></label><button class="secondary">Importer les années complètes</button></form><p>Import des clôtures mensuelles ajustées, puis calcul des rendements entre deux décembres. Minimum trois années complètes, jusqu’à trente années récentes. Une clé et une offre API couvrant cet historique sont nécessaires. L’import ouvre une nouvelle simulation avec les paramètres par défaut ; les rendements restent consultables et modifiables ci-dessous.</p>@if(Source != null){<p>Historique importé : <strong>@Source</strong> · Alpha Vantage. Année courante exclue.</p>}</section>

<section class="panel"><form method="get" data-projection class="form-grid"><SpaceField /><label>Capital initial (€)<input name="initial" data-project="initial" type="number" min="0" max="100000000" step="0.01" value="@Num(Initial)" required /></label><label>Versement mensuel (€)<input name="monthly" data-project="monthly" type="number" min="0" max="100000" step="0.01" value="@Num(Monthly)" required /></label><label>Durée (années)<input name="years" data-project="years" type="number" min="1" max="60" step="1" value="@Years" required /></label><label>Rendement annuel hypothétique (%)<input name="rate" data-project="rate" type="number" min="-99" max="50" step="0.01" value="@Num(Rate)" required /></label><label>Frais annuels (%)<input name="fees" data-project="fees" type="number" min="0" max="10" step="0.01" value="@Num(Fees)" required /></label><label>Inflation annuelle (%)<input name="inflation" data-project="inflation" type="number" min="-99" max="30" step="0.01" value="@Num(Inflation)" required /></label><label class="form-actions">Rendements annuels historiques complets (%) — facultatif<textarea name="history" rows="3" maxlength="3000" placeholder="Exemple de format : 12.3; -8.4; 19.2">@History</textarea><small>Utilisez les performances annuelles ajustées du titre exact, dividendes réinvestis si disponibles. Séparez les valeurs par des points-virgules, avec un point décimal. Aucun historique fictif n’est prérempli.</small></label><button>Calculer et conserver ces paramètres dans l’URL</button></form><p>Les montants estimatifs se mettent à jour à la saisie. Validez pour recalculer tous les scénarios et le tableau annuel.</p></section>
@if(Error != null){<p class="notice error">@Error</p>}
@if(Rows is {} rows){var end=rows[^1];<section class="stats" aria-live="polite"><article class="stat"><span>Capital projeté</span><strong data-projection-total>@Money(end.Nominal)</strong></article><article class="stat"><span>Versements cumulés</span><strong data-projection-contributed>@Money(end.Contributed)</strong></article><article class="stat"><span>Gains estimés</span><strong data-projection-gain>@Money(end.Nominal-end.Contributed)</strong></article><article class="stat"><span>Pouvoir d’achat actuel</span><strong data-projection-real>@Money(end.PurchasingPower)</strong></article></section><p data-projection-warning role="status"></p>
<section class="panel"><h2>Trois scénarios sur @Years ans</h2><p>@(Median == null ? "Base : rendement hypothétique saisi." : $"Base : médiane de {HistoricalCount} années fournies, {Median:0.00} %. La médiane n’est pas une prévision et ne reproduit pas l’ordre des années.")</p><div class="table-scroll"><table><thead><tr><th>Scénario</th><th>Taux brut</th><th>Capital final</th><th>Gains</th></tr></thead><tbody>@foreach(var delta in new[]{-3m,0m,3m}){var r=Math.Clamp(EffectiveRate+delta,-99m,50m);var point=Scenario(r);<tr><td>@(delta<0?"Plus bas":delta>0?"Plus haut":"Central")</td><td>@r.ToString("0.00") %</td><td>@(point == null ? "Capacité dépassée" : Money(point.Nominal))</td><td>@(point == null ? "—" : Money(point.Nominal-point.Contributed))</td></tr>}</tbody></table></div><p>Les écarts de ±3 points sont des hypothèses de sensibilité, pas des intervalles de confiance.</p></section>
<section class="panel"><h2>Évolution projetée</h2>@if(rows.All(r => r.Nominal <= long.MaxValue / 100m && r.Contributed <= long.MaxValue / 100m && r.PurchasingPower <= long.MaxValue / 100m)){ <TimeSeriesChart Dates="rows.Select(r => Today.AddYears(r.Year)).ToArray()" Series="ProjectionSeries(rows)" Title="Simulation : capital et versements projetés" IncludeZero="true" AxisNote="Projection hypothétique annuelle, sans garantie de rendement." /> }<h2>Année par année</h2><div class="table-scroll chart-values"><table><thead><tr><th>Année</th><th>Versements</th><th>Capital estimé</th><th>Pouvoir d’achat</th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@row.Year</td><td>@Money(row.Contributed)</td><td>@Money(row.Nominal)</td><td>@Money(row.PurchasingPower)</td></tr>}</tbody></table></div></section>}
<section class="panel"><h2>Comment lire ces résultats</h2><p>Versements constants en fin de mois, rendement annuel converti en taux mensuel composé, frais proportionnels annuels et inflation constants. Aucun impôt, variation de change, frais de courtage ponctuel ou interruption des versements n’est modélisé. Les performances passées ne garantissent pas les performances futures ; une perte reste possible. Cette simulation ne passe aucun ordre et ne déplace aucune épargne.</p><a href="@Space.Url("/placements")">Comparer à mes placements et livrets ↗</a></section>
@code {
[SupplyParameterFromQuery(Name="initial")]public decimal Initial{get;set;}=750;
[SupplyParameterFromQuery(Name="monthly")]public decimal Monthly{get;set;}=150;
[SupplyParameterFromQuery(Name="years")]public int Years{get;set;}=20;
[SupplyParameterFromQuery(Name="rate")]public decimal Rate{get;set;}=5;
[SupplyParameterFromQuery(Name="fees")]public decimal Fees{get;set;}=.2m;
[SupplyParameterFromQuery(Name="inflation")]public decimal Inflation{get;set;}=2;
[SupplyParameterFromQuery(Name="history")]public string? History{get;set;}
[SupplyParameterFromQuery(Name="source")]public string? Source{get;set;}
private IReadOnlyList<ProjectionPoint>? Rows;private string? Error;private decimal? Median;private int HistoricalCount;private decimal EffectiveRate=>Median??Rate;
private static IReadOnlyList<ChartSeries> ProjectionSeries(IReadOnlyList<ProjectionPoint> rows) => [new("Capital projeté", rows.Select(r => (long)decimal.Round(r.Nominal * 100)).ToArray(), "series-total"), new("Versements", rows.Select(r => (long)decimal.Round(r.Contributed * 100)).ToArray(), "series-personal")];
private ProjectionPoint? Scenario(decimal rate){try{return InvestmentProjection.Calculate(Initial,Monthly,Years,rate,Fees,Inflation)[^1];}catch(RuleException){return null;}}
private static string Num(decimal n)=>n.ToString(CultureInfo.InvariantCulture);private static string Money(decimal n)=>n.ToString("N2",CultureInfo.GetCultureInfo("fr-FR"))+" €";
protected override async Task OnInitializedAsync(){await base.OnInitializedAsync();var q=HttpContext.HttpContext!.Request.Query;if(!q.ContainsKey("initial"))Initial=750;if(!q.ContainsKey("monthly"))Monthly=150;if(!q.ContainsKey("years"))Years=20;if(!q.ContainsKey("rate"))Rate=5;if(!q.ContainsKey("fees"))Fees=.2m;if(!q.ContainsKey("inflation"))Inflation=2;try{if(!string.IsNullOrWhiteSpace(History)){if(History.Length>3000)throw new RuleException("Historique trop long.");var a=History.Split(new[]{';','\r','\n'},StringSplitOptions.RemoveEmptyEntries).Select(s=>decimal.Parse(s.Trim(),CultureInfo.InvariantCulture)).ToArray();HistoricalCount=a.Length;if(a.Length<3)throw new RuleException("Fournissez au moins trois années complètes.");Median=InvestmentProjection.Median(a);}Rows=InvestmentProjection.Calculate(Initial,Monthly,Years,EffectiveRate,Fees,Inflation);}catch(Exception e)when(e is RuleException or FormatException or OverflowException){Error="Vérifiez les paramètres, la durée et les rendements historiques (point décimal, séparation par point-virgule).";}}
}
