@page "/placements"
@attribute [Authorize]
@inherits FinancePage
@inject IPortfolio Portfolio
@inject IMarketPrices Markets
<PageTitle>Placements et simulation · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">ESPACE @Space.Label.ToUpperInvariant()</span><h1>Vos placements, dans le temps<span class="accent">.</span></h1><p>Quantités détenues, valeur historique et comparaison à capital identique.</p></div></header>
<Notice />
<section class="panel"><h2>Mon portefeuille</h2><p class="muted">Saisissez un lot par achat. Le coût investi inclut vos frais. Ces positions ne s’ajoutent pas aux soldes bancaires pour éviter de compter deux fois votre épargne.</p><div class="table-scroll"><table><thead><tr><th>Placement</th><th>Quantité</th><th>Investi</th><th>Achat</th><th></th></tr></thead><tbody>@foreach (var h in Holdings) { <tr><td><a href="@Space.Url("/placements?id=" + h.Id)">@h.Name</a><small>@h.Kind · @h.Symbol</small></td><td>@h.Quantity.ToString("0.########", Fr)</td><td>@Money(h.InvestedEuro)</td><td>@h.Bought.ToString("dd/MM/yyyy")</td><td><form method="post" action="/portfolio/delete"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@h.Id" /><button class="secondary small-button">Supprimer ce lot</button></form></td></tr> }</tbody></table></div>@if (Holdings.Count == 0) { <p>Ajoutez votre premier achat ci-dessous.</p> }</section>
@if (Selected is { } selected)
{
    <section class="panel"><h2>@selected.Name · @selected.Quantity.ToString("0.########", Fr) unité(s)</h2><form method="get" class="filters"><SpaceField /><input name="id" type="hidden" value="@selected.Id" /><label>Comparer à la date<input type="date" name="date" value="@Iso(ComparisonDate)" max="@Iso(Today)" min="1900-01-01" /></label><label>Prix unitaire actuel manuel (€)<input name="nowEuro" type="number" min="0.00000001" max="100000000" step="0.00000001" value="@(NowEuro == null ? "" : Num(NowEuro.Value))" /></label><label>Prix unitaire à la date comparée (€)<input name="pastEuro" type="number" min="0.00000001" max="100000000" step="0.00000001" value="@(PastEuro == null ? "" : Num(PastEuro.Value))" /><small>Facultatif : votre relevé historique si le cours API manque.</small></label><button>Comparer</button></form><div class="button-row"><a href="@Space.Url("/placements?id=" + selected.Id + "&date=" + Iso(Today.AddMonths(-2)))">Il y a deux mois</a><a href="@Space.Url("/placements?id=" + selected.Id + "&date=" + Iso(Today.AddYears(-2)))">Il y a deux ans</a></div>
        <div class="stats"><article class="stat"><span>Dernier cours disponible</span><strong>@Price(Current)</strong><small>@Description(Current)</small></article><article class="stat"><span>Cours à la date comparée ou avant</span><strong>@Price(Past)</strong><small>@Description(Past)</small></article><article class="stat"><span>Valeur de votre quantité au dernier cours</span><strong>@(Current == null ? "Indisponible" : InvestmentMath.Value(selected.Quantity, Current.Price).ToString("N2", Fr) + " " + Current.Currency)</strong><small>La quantité actuelle est utilisée aux deux dates ; ce n’est pas une reconstitution de vos achats et ventes passés.</small></article></div>
        @if (Current != null && Past != null && Current.Currency == Past.Currency && Past.Price > 0) { <p>Variation de la valeur à quantité constante : <strong>@((selected.Quantity * (Current.Price - Past.Price)).ToString("N2", Fr)) @Current.Currency</strong> (@((100 * (Current.Price / Past.Price - 1)).ToString("0.00", Fr)) %).</p> }
        <p class="muted">Cryptos : cours en EUR via CoinGecko, cache de 30 minutes. Actions et ETF : clôtures mensuelles Alpha Vantage, en devise de cotation, sous réserve de couverture et de quota. Les cours non ajustés ne corrigent pas les divisions de titres et ne réinvestissent pas les dividendes. Un historique manquant reste indisponible.</p>
    </section>
}
<section class="panel"><h2>Comparer mon placement à un livret</h2><p>Exemple : 750 € investis et 900 € aujourd’hui. Renseignez vos dates exactes et les valeurs en euros, après conversion si nécessaire.</p><form method="get" class="form-grid"><SpaceField />@if (Selected != null) { <input type="hidden" name="id" value="@Selected.Id" /> }<label>Capital de départ (€)<input type="number" name="capital" min="0.01" max="100000000" step="0.01" value="@Num(Capital ?? Selected?.InvestedEuro ?? 750)" required /></label><label>Valeur finale du placement (€)<input type="number" name="final" min="0" max="100000000" step="0.01" value="@Num(Final ?? SuggestedFinal)" required /></label><label>Début<input type="date" name="start" value="@(Start ?? Iso(Selected?.Bought ?? Today.AddMonths(-10)))" max="@Iso(Today)" min="1900-01-01" required /></label><label>Fin<input type="date" name="end" value="@(End ?? Iso(Today))" max="@Iso(Today)" min="1900-01-01" required /></label><label>Hypothèse Livret A / LDDS (% annuel)<input name="rateA" type="number" step="0.01" min="0" max="100" value="@Num(RateA ?? 1.7m)" required /></label><label>Hypothèse LEP (% annuel)<input name="rateL" type="number" step="0.01" min="0" max="100" value="@Num(RateL ?? 2.5m)" required /></label><button>Simuler à durée identique</button></form>
    @if (SimulationError != null) { <p class="notice error">@SimulationError</p> }
    @if (Simulation is { } sim) { <div class="table-scroll"><table><thead><tr><th>Scénario</th><th>Valeur finale</th><th>Gain</th><th>Écart avec votre placement</th></tr></thead><tbody><tr><td>Votre placement</td><td>@Money(Final!.Value)</td><td>@Money(Final.Value - Capital!.Value)</td><td>—</td></tr>@foreach (var row in sim) { <tr><td>@row.Name</td><td>@Money(row.Value)</td><td>@Money(row.Value - Capital!.Value)</td><td>@Money(Final!.Value - row.Value)</td></tr> }</tbody></table></div> }
    <p class="data-method">Simulation à taux constant et capitalisation annuelle fractionnée, sans versement ni retrait intermédiaire. Les taux proposés sont des hypothèses modifiables : ce résultat ne reproduit pas les changements historiques de taux ni le calcul réglementaire par quinzaines. Frais, fiscalité du placement et conditions d’éligibilité au LEP ne sont pas déduits. Un placement risqué et un livret n’offrent pas les mêmes garanties.</p>
</section>
<section class="panel"><h2>Ajouter un achat</h2><form method="post" action="/portfolio/add" class="form-grid"><AntiforgeryToken /><SpaceField /><label>Nom<input name="name" maxlength="100" required placeholder="Ethereum, ETF S&P 500…" /></label><label>Type<select name="kind"><option value="crypto">Crypto</option><option value="action">Action</option><option value="etf">ETF</option></select></label><label>Identifiant du fournisseur<input name="symbol" maxlength="50" required placeholder="ethereum, bitcoin, symbole Alpha Vantage" /><small>Crypto : identifiant CoinGecko (ethereum, pas ETH). Action/ETF : symbole exact de la place de cotation, pas seulement le nom commercial.</small></label><label>Quantité<input name="quantity" type="number" step="0.00000001" min="0.00000001" max="1000000000000" required /></label><label>Total investi, frais inclus (€)<input name="invested" type="number" step="0.01" min="0" max="100000000" required /></label><label>Date d’achat<input name="bought" type="date" value="@Iso(Today)" max="@Iso(Today)" min="1900-01-01" required /></label><label>Prix unitaire manuel en euros (facultatif)<input name="manual" type="number" min="0" max="100000000" step="0.00000001" /><small>Utilisé pour préremplir la simulation si le cours EUR n’est pas disponible.</small></label><button>Ajouter à cet espace</button></form></section>
@code {
    [SupplyParameterFromQuery(Name="id")] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name="date")] public string? Date { get; set; }
    [SupplyParameterFromQuery(Name="capital")] public decimal? Capital { get; set; }
    [SupplyParameterFromQuery(Name="final")] public decimal? Final { get; set; }
    [SupplyParameterFromQuery(Name="start")] public string? Start { get; set; }
    [SupplyParameterFromQuery(Name="end")] public string? End { get; set; }
    [SupplyParameterFromQuery(Name="rateA")] public decimal? RateA { get; set; }
    [SupplyParameterFromQuery(Name="rateL")] public decimal? RateL { get; set; }
    [SupplyParameterFromQuery(Name="nowEuro")] public decimal? NowEuro { get; set; }
    [SupplyParameterFromQuery(Name="pastEuro")] public decimal? PastEuro { get; set; }
    private IReadOnlyList<Holding> Holdings = []; private Holding? Selected; private MarketPrice? Current, Past; private DateOnly ComparisonDate;
    private (string Name, decimal Value)[]? Simulation; private string? SimulationError;
    private decimal SuggestedFinal => Selected == null ? 900 : Current?.Currency == "EUR" ? InvestmentMath.Value(Selected.Quantity, Current.Price) : InvestmentMath.Value(Selected.Quantity, Selected.ManualPriceEuro ?? 0);
    private static readonly CultureInfo Fr = CultureInfo.GetCultureInfo("fr-FR");
    private static string Num(decimal n) => n.ToString(CultureInfo.InvariantCulture);
    private static string Money(decimal n) => n.ToString("N2", Fr) + " €";
    private static string Price(MarketPrice? p) => p == null ? "Indisponible" : p.Price.ToString("N2", Fr) + " " + p.Currency;
    private static string Description(MarketPrice? p) => p == null ? "Cours absent, clé API manquante ou quota atteint." : p.Source + " · " + p.Date.ToString("dd/MM/yyyy");
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync(); Holdings = await Portfolio.ReadAsync(Actor, Space.IsCouple); Selected = Id == null ? Holdings.FirstOrDefault() : Holdings.SingleOrDefault(h => h.Id == Id);
        ComparisonDate = DateOnly.TryParseExact(Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) && date <= Today && date.Year >= 1900 ? date : Today.AddMonths(-2);
        if (Selected != null) { var now = Markets.ReadAsync(Selected.Kind, Selected.Symbol, Today); var past = Markets.ReadAsync(Selected.Kind, Selected.Symbol, ComparisonDate); await Task.WhenAll(now, past); Current = await now; Past = await past; }
        if (NowEuro is > 0 and <= 100000000) Current = new(NowEuro.Value, Today, "EUR", "Saisie manuelle");
        if (PastEuro is > 0 and <= 100000000) Past = new(PastEuro.Value, ComparisonDate, "EUR", "Saisie historique manuelle");
        if (Capital != null && Final != null) try { if (Capital <= 0 || Capital > 100000000 || Final < 0 || Final > 100000000) throw new RuleException("Montants invalides."); var from = DateOnly.ParseExact(Start!, "yyyy-MM-dd", CultureInfo.InvariantCulture); var to = DateOnly.ParseExact(End!, "yyyy-MM-dd", CultureInfo.InvariantCulture); if (to > Today || from.Year < 1900) throw new RuleException("Dates invalides."); Simulation = [("Livret A / LDDS · taux constant", InvestmentMath.Scenario(Capital.Value, RateA ?? 1.7m, from, to)), ("LEP · taux constant", InvestmentMath.Scenario(Capital.Value, RateL ?? 2.5m, from, to))]; } catch (Exception e) when (e is RuleException or FormatException or ArgumentException or OverflowException) { SimulationError = "Vérifiez les dates, montants et taux de la simulation."; }
    }
}
