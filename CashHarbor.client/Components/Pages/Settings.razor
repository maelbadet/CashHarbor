@page "/parametres"
@attribute [Authorize]
@inherits FinancePage
@inject IIdentityService Identity
@inject IReminderService Reminders
<PageTitle>Paramètres · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">VOTRE ESPACE, VOS REPÈRES</span><h1>Gardez le cap<span class="accent">.</span></h1><p>Les préférences du foyer et la sécurité de votre accès.</p></div></header>
<Notice />
@if (W != null)
{
    var reserve = SafetyReserve.Calculate(ReserveWorkspace!, Space.IsCouple);
    var target = reserve.TargetCents;
    var liquid = reserve.SavedCents;
    @if (Mail is { } mail)
    {
        <section class="panel reminder-panel" id="rappels"><span class="eyebrow">VOTRE RENDEZ-VOUS MENSUEL</span><h2>Rappels par e-mail</h2><p>Un rappel pour mettre à jour vos comptes. Aucun montant ni donnée bancaire n’est envoyé.</p>
            <div class="grid-two">
                <form class="stack" method="post" action="/actions/reminder-save"><AntiforgeryToken /><SpaceField /><h3>Mon rappel personnel</h3><p class="muted">Destinataire : <strong>@mail.Recipient</strong>. Chacun active son propre rappel depuis son compte.</p><label class="check"><input type="checkbox" name="enabled" checked="@mail.Preferences.Enabled" /> Recevoir un rappel chaque mois</label><label>Jour du mois<input type="number" name="day" min="1" max="31" value="@mail.Preferences.Day" required /></label><label>Heure à Paris<input type="number" name="hour" min="0" max="23" value="@mail.Preferences.Hour" required /><small>En fin de mois, le jour est ramené au dernier jour disponible. Envoi dans les 15 minutes suivant l’heure choisie.</small></label><button>Enregistrer mon rappel</button></form>
                <div class="stack"><h3>État des envois</h3><p>@(mail.HasPassword ? "SMTP enregistré" : "SMTP à configurer") · @(mail.Preferences.Enabled ? "Mon rappel est activé" : "Mon rappel est désactivé")</p><p class="muted">@(mail.Preferences.Status ?? "Aucun envoi effectué.")</p>@if (mail.Preferences.LastSent is { } sent) { <p>Dernier rappel : @ReminderSchedule.Local(sent).ToString("dd/MM/yyyy HH:mm") (Paris)</p> }<form method="post" action="/actions/reminder-test"><AntiforgeryToken /><SpaceField /><button class="secondary" disabled="@(!mail.HasPassword)">M’envoyer un e-mail de test</button></form><p class="muted">Le test est envoyé uniquement à votre adresse de connexion. Il ne remplace pas le rappel mensuel.</p></div>
            </div>
            <details class="smtp-settings"><summary>Configurer le serveur SMTP commun</summary><p class="muted">Configuration commune aux deux utilisateurs. Mot de passe stocké chiffré et jamais réaffiché. Hostinger Email : smtp.hostinger.com, port 465 avec TLS.</p><form class="form-grid" method="post" action="/actions/smtp-save"><AntiforgeryToken /><SpaceField /><label>Serveur<input name="host" value="@mail.Smtp.Host" maxlength="253" required autocomplete="off" /></label><label>Port<select name="port"><option value="465" selected="@(mail.Smtp.Port == 465)">465 — TLS</option><option value="587" selected="@(mail.Smtp.Port == 587)">587 — STARTTLS</option></select></label><label>Chiffrement<select name="encryption"><option value="Tls" selected="@(mail.Smtp.Encryption == SmtpEncryption.Tls)">TLS dès la connexion (465)</option><option value="StartTls" selected="@(mail.Smtp.Encryption == SmtpEncryption.StartTls)">STARTTLS obligatoire (587)</option></select></label><label>Identifiant SMTP<input name="username" value="@mail.Smtp.Username" maxlength="254" required autocomplete="off" /></label><label>Adresse d’envoi<input name="from" type="email" value="@mail.Smtp.From" maxlength="254" required /></label><label>Mot de passe de la boîte mail<input name="smtpPassword" type="password" maxlength="1024" autocomplete="new-password" placeholder="@(mail.HasPassword ? "Laisser vide pour conserver" : "Mot de passe SMTP")" required="@(!mail.HasPassword)" /><small>Mot de passe de la boîte mail, pas du compte Hostinger.</small></label><div class="form-actions"><button class="secondary">Enregistrer le SMTP</button></div></form></details>
        </section>
    }
    <section class="panel reserve"><span class="eyebrow">VOTRE MARGE DE TRANQUILLITÉ</span><h2>Épargne de sûreté · @Space.Label</h2><div class="stats compact"><div><small>Cible sur @reserve.Months mois</small><strong>@Euro(target)</strong></div><div><small>Comptes d’épargne de cet espace</small><strong>@Euro(liquid)</strong></div><div><small>Reste à constituer</small><strong>@Euro(reserve.MissingCents)</strong></div></div><p>Base des dépenses communes : <strong>@Euro(reserve.CommonMonthlyCents) / mois</strong>. Répartition à parts égales.</p><p>Calcul : (<strong>@((reserve.MonthlyShareCents/100m).ToString("N2")) €</strong> de dépenses @(Space.IsCouple ? "pour le foyer" : "pour votre moitié") + <strong>@Euro(reserve.MonthlyMarginCents)</strong> de marge mensuelle) × <strong>@reserve.Months mois</strong>.</p><p class="muted">@(Space.IsCouple ? "La marge du couple comprend deux marges individuelles. Avec 1 000 € de dépenses et 100 € de marge chacun : (1 000 + 200) × 8 = 9 600 €." : "Avec 1 000 € de dépenses communes et 100 € de marge : (500 + 100) × 8 = 4 800 € pour vous.") La marge couvre les imprévus voiture, animal et autres incidents. Les comptes courants et placements sont exclus de la réserve constituée.</p><p class="muted">@(W.EmergencyPolicy.SharedMonthlyExpenseCents == null ? "Base automatique : récurrences communes actives marquées essentielles, annualisées au besoin." : "Base mensuelle manuelle, commune aux deux utilisateurs.") Les comptes d’épargne de cet espace sont tous comptés ; si une partie finance un autre projet, elle ne constitue pas nécessairement une réserve disponible.</p></section>
    <div class="grid-two"><section class="panel"><h2>Notre foyer</h2><form class="stack" method="post" action="/actions/settings-save"><AntiforgeryToken /><SpaceField /><label>Nom de l’espace<input name="name" value="@W.Name" maxlength="100" required /></label><label>Mois de dépenses à couvrir<input name="months" type="number" min="1" max="24" value="@W.EmergencyPolicy.SafetyMonths" required /></label><label>Marge mensuelle par personne (€)<input name="buffer" type="number" min="0" max="100000000" step="0.01" value="@Amount(W.EmergencyPolicy.MonthlySafetyMarginCents)" required /></label><label>Dépenses communes mensuelles (€), facultatif<input name="sharedMonthly" type="number" min="0" max="100000000" step="0.01" value="@(W.EmergencyPolicy.SharedMonthlyExpenseCents is {} amount ? Amount(amount) : "")" placeholder="Ex. 1000" /><small>Laisser vide pour utiliser les récurrences communes essentielles. Saisir le total du couple, avant division par deux.</small></label><button>Enregistrer les préférences communes</button></form></section>
    <section class="panel"><h2>Votre mot de passe</h2><p class="muted">Le changement révoque toutes les sessions de votre accès.</p><form class="stack" method="post" action="/actions/password-change"><AntiforgeryToken /><SpaceField /><label>Mot de passe actuel<input name="current" type="password" autocomplete="current-password" maxlength="128" required /></label><label>Nouveau mot de passe<input name="password" type="password" autocomplete="new-password" minlength="14" maxlength="128" required /><small>14 caractères minimum. Utilisez un mot de passe unique.</small></label><label>Nouveau code d’authentification<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required /></label><button class="secondary">Modifier et me reconnecter</button></form></section></div>
    <section class="panel"><h2>Vos données vous appartiennent.</h2><p class="muted">Les exports sont en clair : conservez-les dans un emplacement protégé. L’export JSON contient les données du foyer, pas les accès ni les clés. La restauration complète passe par une sauvegarde du serveur.</p><div class="button-row"><a class="button secondary" href="/export/csv">Exporter les opérations · CSV ↗</a><a class="button secondary" href="/export/json">Exporter le foyer · JSON ↗</a></div></section>
    <section class="panel"><h2>Mon activité récente</h2><p class="muted">Les 50 derniers événements de votre accès uniquement, sans libellés ni montants. Horaires en UTC.</p><div class="table-scroll"><table><thead><tr><th>Horodatage UTC</th><th>Événement</th></tr></thead><tbody>@foreach (var e in Events) { <tr><td>@e.At.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@e.Action</td></tr> }</tbody></table></div></section>
}
@code {
    private IReadOnlyList<SecurityEvent> Events = [];
    private ReminderView? Mail;
    private Workspace? ReserveWorkspace;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); ReserveWorkspace = await Finance.ReadAsync(Actor); Events = await Identity.EventsAsync(Actor); Mail = await Reminders.ReadAsync(Actor); }
}
