@page "/prets/{Id:guid}"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Suivi du prêt · CashHarbor</PageTitle>
@if (W != null)
{
    var loan = W.Loans.SingleOrDefault(l => l.Id == Id);
    if (loan == null)
    {
        HttpContext.HttpContext!.Response.StatusCode = 404;
        <section class="empty"><h1>Prêt introuvable.</h1><a class="button secondary" href="/prets">Revenir à mes prêts</a></section>
    }
    else
    {
        var rows = LoanCalculator.Schedule(loan); var paid = LoanCalculator.PaidCount(loan, W.LoanPayments); var remaining = LoanCalculator.Remaining(loan, W.LoanPayments); var next = paid < rows.Count ? rows[paid] : null;
        var payments = W.LoanPayments.Where(p => p.LoanId == Id).OrderByDescending(p => p.InstallmentNumber).ToArray();
        var pages = Math.Max(1, (rows.Count + 23) / 24); var current = Math.Clamp(Page ?? (paid / 24 + 1), 1, pages);
        <header class="page-header"><div><span class="eyebrow">@Visibility(loan.Visibility) · @LoanForm.LoanLabel(loan.Kind)</span><h1>@loan.Name<span class="accent">.</span></h1><p>@loan.Lender · taux nominal fixe @LoanForm.Rate(loan.AnnualNominalRate) % · durée prévue @loan.TermMonths mois</p></div><a class="button secondary" href="/export/loan/@loan.Id/csv">Exporter l’amortissement ↗</a></header>
        <Notice />
        <section class="stats"><article class="stat dark"><span>Capital restant dû</span><strong>@Euro(remaining)</strong><small>@paid échéance(s) déclarée(s) ou confirmée(s)</small></article><article class="stat"><span>Intérêts estimés sur toute la durée</span><strong>@Euro(rows.Sum(r => r.InterestCents))</strong><small>Au taux nominal fixe saisi</small></article><article class="stat"><span>Assurance estimée sur toute la durée</span><strong>@Euro(rows.Sum(r => r.InsuranceCents))</strong><small>@InsuranceLabel(loan)</small></article><article class="stat"><span>Coût estimé hors capital</span><strong>@Euro(rows.Sum(r => r.InterestCents + r.InsuranceCents) + loan.FeesCents)</strong><small>Intérêts + assurance + frais saisis</small></article></section>
        <section class="panel"><div class="row-between"><h2>@(remaining == 0 ? "Ce prêt est soldé." : "Le capital diminue, étape par étape.")</h2><strong>@paid / @rows.Count</strong></div><meter min="0" max="@loan.PrincipalCents" value="@(loan.PrincipalCents - remaining)" aria-label="Capital remboursé"></meter><p class="muted">Capital initial @Euro(loan.PrincipalCents) · première échéance @rows[0].DueDate.ToString("dd/MM/yyyy") · dernière échéance calculée @rows[^1].DueDate.ToString("dd/MM/yyyy"). @if (loan.ContractApr != null) { <span>TAEG du contrat : @LoanForm.Rate(loan.ContractApr.Value) % (informatif).</span> }</p><p class="fine">Le capital restant suit vos confirmations, pas le simple passage du temps. @loan.InitialPaidInstallments échéance(s) reprise(s) à l’ajout du prêt, sans création d’anciennes opérations.</p></section>
        <div class="grid-two">
            <section class="panel"><h2>Prochaine échéance</h2>
            @if (next == null) { <p class="muted">Toutes les échéances ont été réglées.</p> }
            else
            {
                <strong class="account-balance">@Euro(next.TotalCents)</strong><p class="muted">Échéance @next.Number du @next.DueDate.ToString("dd/MM/yyyy") : capital @Euro(next.PrincipalCents), intérêts @Euro(next.InterestCents), assurance @Euro(next.InsuranceCents).</p>
                @if (next.DueDate > Today) { <p class="notice neutral">Cette échéance n’est pas encore arrivée à terme. Aucun règlement ni débit automatique n’est effectué.</p> }
                else { <form class="stack" method="post" action="/actions/loan-confirm"><AntiforgeryToken /><input name="id" type="hidden" value="@Id" /><input name="number" type="hidden" value="@next.Number" /><label>Date réelle du règlement<input name="paidOn" type="date" min="@Iso(payments.Length == 0 ? loan.TrackingStartedOn : payments[0].PaidOn)" max="@Iso(Today)" value="@Iso(Today)" required /></label><label>Comptabilisation<select name="mode"><option value="tracking">Suivi du prêt uniquement — dépense déjà saisie ou à saisir séparément</option>@if (loan.PaymentAccountId != null) { <option value="expense">Créer aussi la dépense sur le compte de remboursement</option> }</select></label><p class="fine">Choisir la création de dépense uniquement si cette mensualité n’existe pas déjà dans vos opérations ou échéances récurrentes.</p><button>Confirmer cette échéance</button></form> }
            }
            </section>
            <section class="panel"><h2>Compte de remboursement</h2><p class="muted">@(loan.PaymentAccountId == null ? "Aucun compte associé. Le prêt peut être suivi sans mouvement bancaire." : W.Accounts.Single(a => a.Id == loan.PaymentAccountId).Name)</p><form class="stack" method="post" action="/actions/loan-account"><AntiforgeryToken /><input name="id" type="hidden" value="@Id" /><label>Compte de même visibilité<select name="account"><option value="">Aucun</option>@foreach (var a in W.Accounts.Where(a => a.Visibility == loan.Visibility && a.OwnerId == loan.OwnerId)) { <option value="@a.Id" selected="@(a.Id == loan.PaymentAccountId)">@a.Name</option> }</select></label><button class="secondary">Enregistrer le compte</button></form>
            @if (payments.Length > 0) { var last = payments[0]; <details class="danger-zone"><summary>Annuler le dernier règlement</summary><p>L’échéance @last.InstallmentNumber redeviendra à régler. Seule la dépense générée par cette confirmation sera supprimée ; une dépense saisie séparément restera inchangée.</p><form method="post" action="/actions/loan-undo"><AntiforgeryToken /><input name="id" type="hidden" value="@Id" /><input name="number" type="hidden" value="@last.InstallmentNumber" /><button class="danger">Confirmer l’annulation</button></form></details> }
            </section>
        </div>
        <section class="panel"><div class="section-heading"><div><span class="eyebrow">UNE ESTIMATION EXPLICABLE</span><h2>Tableau d’amortissement</h2></div><span class="muted">Page @current / @pages</span></div><p class="fine">Mensualités estimées à taux fixe, assurance selon le mode choisi. La banque peut appliquer d’autres conventions d’intérêts ou d’arrondis. Les frais initiaux sont présentés séparément : @Euro(loan.FeesCents).</p><div class="table-scroll"><table><thead><tr><th>N°</th><th>Date prévue</th><th>Capital</th><th>Intérêts</th><th>Assurance</th><th>Total</th><th>Capital restant</th><th>Statut</th></tr></thead><tbody>@foreach (var r in rows.Skip((current - 1) * 24).Take(24)) { <tr class="@(r.Number <= paid ? "paid-row" : "")"><td>@r.Number</td><td class="nowrap">@r.DueDate.ToString("dd/MM/yyyy")</td><td class="number">@Euro(r.PrincipalCents)</td><td class="number">@Euro(r.InterestCents)</td><td class="number">@Euro(r.InsuranceCents)</td><td class="number">@Euro(r.TotalCents)</td><td class="number">@Euro(r.RemainingCents)</td><td class="nowrap">@(r.Number <= loan.InitialPaidInstallments ? "Déclarée à l’ajout" : r.Number <= paid ? "Réglée" : r.DueDate <= Today ? "À confirmer" : "À venir")</td></tr> }</tbody></table></div><div class="pagination">@if (current > 1) { <a class="button secondary" href="/prets/@Id?p=@(current - 1)">← Précédent</a> } @if (current < pages) { <a class="button secondary" href="/prets/@Id?p=@(current + 1)">Suivant →</a> }</div></section>
        @if (payments.Length > 0) { <section class="panel"><h2>Règlements confirmés</h2><div class="table-scroll"><table><thead><tr><th>Échéance</th><th>Date réelle</th><th>Opération</th></tr></thead><tbody>@foreach (var p in payments) { <tr><td>@p.InstallmentNumber</td><td>@p.PaidOn.ToString("dd/MM/yyyy")</td><td>@(p.TransactionId == null ? "Suivi uniquement" : "Dépense générée")</td></tr> }</tbody></table></div></section> }
        <section class="panel"><details><summary>Corriger le contrat</summary>@if (payments.Length > 0) { <p class="muted">Annulez les règlements enregistrés depuis l’ajout avant de modifier le contrat. Les mensualités reprises à l’ajout restent modifiables dans le contrat.</p> } else { <LoanForm Value="loan" Accounts="W.Accounts" Today="Today" /> }</details><details class="danger-zone"><summary>Supprimer ce prêt</summary><p>Cette action retire le prêt du suivi et du solde net. Les règlements enregistrés doivent être annulés avant suppression.</p><form method="post" action="/actions/loan-delete"><AntiforgeryToken /><input name="id" type="hidden" value="@Id" /><button class="danger">Supprimer le prêt</button></form></details></section>
    }
}
@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "p")] public int? Page { get; set; }
    private static string InsuranceLabel(Loan loan) => loan.InsuranceKind switch { LoanInsuranceKind.InitialCapitalRate => LoanForm.Rate(loan.AnnualInsuranceRate) + " % / an sur capital initial", LoanInsuranceKind.RemainingCapitalRate => LoanForm.Rate(loan.AnnualInsuranceRate) + " % / an sur capital restant", _ => Euro(loan.MonthlyInsuranceCents) + " / mois" };
}
