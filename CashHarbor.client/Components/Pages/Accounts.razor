@page "/comptes"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Comptes et épargne · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">PERSONNEL OU COMMUN, UN SUIVI COMPLET</span><h1>@(SavingsOnly ? "Votre épargne disponible" : InvestmentsOnly ? "Vos comptes de placement" : "Vos comptes, à leur place")<span class="accent">.</span></h1><p>Vos comptes personnels restent privés. Les comptes communs sont accessibles à vous deux.</p></div><a class="button" href="@FormAnchor">Ajouter un compte ↗</a></header>
<Notice />
@if (W != null)
{
    var accounts = W.Accounts.Where(a => !SavingsOnly || a.Kind == AccountKind.Savings).Where(a => !InvestmentsOnly || a.Kind == AccountKind.Investment).ToArray();
    <p class="notice neutral">Espace @Space.Label.ToLowerInvariant() : les comptes de cet espace uniquement.</p>   @foreach (var visibility in new[] { AccountVisibility.Personal, AccountVisibility.Joint })
    {
        var group = accounts.Where(a => a.Visibility == visibility).ToArray();
        if (group.Length == 0) { continue; }
        <div class="section-heading account-section"><div><span class="eyebrow">@Visibility(visibility)</span><h2>@(visibility == AccountVisibility.Personal ? "Mes comptes personnels" : "Nos comptes communs")</h2></div><strong>@Euro(group.Sum(a => W.Balance(a.Id)))</strong></div>
        <div class="account-grid">
        @foreach (var a in group)
        {
            <article class="panel account-card">
                <div class="row-between"><span class="tag">@Kind(a.Kind)</span><span class="account-symbol">@(visibility == AccountVisibility.Personal ? "◈" : "◉")</span></div>
                <h2>@a.Name</h2><p class="muted">@a.Institution @(string.IsNullOrEmpty(a.Product) ? "" : "· " + a.Product)</p>
                <span class="tag visibility-tag">@Visibility(a.Visibility)</span>
                <strong class="account-balance">@Euro(W.Balance(a.Id))</strong>
                @if(SavingsLimits.For(a) is {} limit){var balance=W.Balance(a.Id);<div class="savings-limit"><div class="row-between"><small>Plafond de versement</small><strong>@Euro(limit.CeilingCents)</strong></div><meter min="0" max="@limit.CeilingCents" value="@Math.Clamp(balance,0,limit.CeilingCents)" aria-label="Plafond du livret utilisé"></meter><p>@(balance>=limit.CeilingCents?"Plafond atteint : aucun nouveau versement disponible.":"Marge de versement selon le solde enregistré : "+Euro(limit.RemainingCents(balance)))</p><small>Les intérêts peuvent porter le solde au-delà du plafond. Le solde reste affiché intégralement. <a href="@limit.Source" target="_blank" rel="noopener noreferrer">Règles officielles ↗</a></small></div>}
                <small>Solde initial @Euro(a.OpeningCents) au @a.OpeningDate.ToString("dd/MM/yyyy")</small>
                <a href="/operations?compte=@a.Id">Voir les opérations ↗</a>
                <details><summary>Évolution et relevés de solde</summary>
                    <BalanceHistoryChart Workspace="W" Today="Today" AccountId="a.Id" />
                    <p class="muted">Indiquez le solde réel affiché par votre banque, y compris pour vos placements. Un ajustement sera enregistré sans compter comme revenu ou dépense.</p>
                    <form class="stack" method="post" action="/actions/account-balance"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@a.Id" />
                        <label>Solde constaté (€)<input type="number" name="balance" min="-100000000" max="100000000" step="0.01" value="@Amount(W.Balance(a.Id))" required /></label>
                        <label>Date du relevé<input type="date" name="date" min="@Iso(a.OpeningDate)" max="@Iso(Today)" value="@Iso(Today)" required /></label>
                        <button class="secondary">Enregistrer le solde</button>
                    </form>
                    @if (W.Snapshots.Any(s => s.AccountId == a.Id))
                    {
                        <div class="table-scroll"><table><thead><tr><th>Date</th><th>Solde constaté</th></tr></thead><tbody>@foreach (var s in W.Snapshots.Where(s => s.AccountId == a.Id).OrderByDescending(s => s.Date)) { <tr><td>@s.Date.ToString("dd/MM/yyyy")</td><td>@Euro(s.BalanceCents)</td></tr> }</tbody></table></div>
                    }
                </details>
                <details><summary>Modifier ce compte</summary><form class="stack" method="post" action="/actions/account-edit"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@a.Id" /><label>Nom<input name="name" value="@a.Name" maxlength="100" required /></label><label>Établissement<input name="institution" value="@a.Institution" maxlength="100" required /></label><label>Produit ou livret<input name="product" list="products" value="@a.Product" maxlength="60" /><small>Choisir Livret A, LEP ou Livret jeune pour afficher son plafond.</small></label><button class="secondary">Enregistrer</button></form></details>
                @if (a.Visibility == AccountVisibility.Personal)
                {
                    <details class="danger-zone"><summary>Partager ce compte avec mon foyer</summary><p>Son nom, ses soldes, toutes ses opérations passées et futures ainsi que ses échéances deviendront visibles par vous deux. Le partage ne peut pas être annulé depuis l’interface.</p><form class="stack" method="post" action="/actions/account-share"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@a.Id" /><label class="checkbox"><input type="checkbox" name="confirm" required /> Je confirme le partage de tout l’historique.</label><button>Rendre ce compte commun</button></form></details>
                }
                <details class="danger-zone"><summary>Supprimer ce compte</summary><p>Possible uniquement sans opération, échéance ni relevé.</p><form method="post" action="/actions/account-delete"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@a.Id" /><button class="danger">Supprimer définitivement</button></form></details>
            </article>
        }
        </div>
    }
    @if (accounts.Length == 0) { <section class="panel empty"><span class="empty-symbol">▤</span><h2>Aucun compte dans cette vue.</h2><p>Ajoutez un compte personnel ou commun, puis suivez son solde et son évolution.</p></section> }
    <section class="panel form-panel" id="ajouter"><span class="eyebrow">UN NOUVEAU REPÈRE</span><h2>@(SavingsOnly ? "Ajouter un compte d’épargne" : InvestmentsOnly ? "Ajouter un compte de placement" : "Ajouter un compte")</h2><p class="muted">Ce compte sera créé dans l’espace @Space.Label.ToLowerInvariant(). @(Space.IsCouple ? "Il sera accessible à vous deux." : "Il restera visible uniquement par vous.")</p>
        <form class="form-grid" method="post" action="/actions/account-add"><AntiforgeryToken /><SpaceField />
            <label>Nom du compte<input name="name" placeholder="Mon Livret A, notre compte joint…" maxlength="100" required /></label>
            <input type="hidden" name="visibility" value="@Space.Visibility" /><div><small>Destination</small><p>Espace @Space.Label.ToLowerInvariant()</p></div>
            <label>Établissement<input name="institution" placeholder="Votre banque" maxlength="100" required /></label>
            <label>Type<select name="kind">@if (!SavingsOnly && !InvestmentsOnly) { <option value="Current">Compte courant</option> } @if (!InvestmentsOnly) { <option value="Savings">Épargne disponible</option> } @if (!SavingsOnly) { <option value="Investment">Placement à long terme</option> }</select></label>
            <label>Produit ou support (facultatif)<input name="product" list="products" maxlength="60" placeholder="Livret A, LDDS, PEL, assurance-vie…" /><datalist id="products"><option>Livret A</option><option>LDDS</option><option>LEP</option><option>Livret jeune</option><option>PEL</option><option>CEL</option><option>Livret bancaire</option><option>Assurance-vie</option><option>PEA</option><option>Compte-titres</option><option>PER</option></datalist><small>Le libellé décrit votre suivi ; les règles de détention et les intérêts ne sont pas calculés automatiquement.</small></label>
            <label>Solde de départ (€)<input name="opening" type="number" step="0.01" min="-100000000" max="100000000" value="0" required /></label>
            <label>Date du solde de départ<input name="date" type="date" value="@Iso(Today)" min="1900-01-01" max="@Iso(Today)" required /></label>
            <div class="form-actions"><button>Créer le compte ↗</button></div>
        </form>
    </section>
}
@code {
    [SupplyParameterFromQuery(Name = "vue")] public string? Scope { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeFilter { get; set; }
    private bool SavingsOnly => TypeFilter == "epargne";
    private bool InvestmentsOnly => TypeFilter == "placements";
}
