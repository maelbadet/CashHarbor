@page "/comptes"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Comptes · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">LE POINT DE DÉPART</span><h1>Vos comptes, réunis<span class="orange">.</span></h1><p>Un même regard sur votre quotidien et votre épargne.</p></div><a class="button" href="#ajouter">Ajouter un compte ↗</a></header>
<Notice />
@if (W != null)
{
    <div class="account-grid">
    @foreach (var a in W.Accounts)
    {
        <article class="panel account-card"><div class="row-between"><span class="tag">@Kind(a.Kind)</span><span class="account-symbol">▤</span></div><h2>@a.Name</h2><p class="muted">@a.Institution</p><strong class="account-balance">@Euro(W.Balance(a.Id))</strong><small>Solde initial @Euro(a.OpeningCents) au @a.OpeningDate.ToString("dd/MM/yyyy")</small><a href="/operations?compte=@a.Id">Voir les opérations ↗</a>
        <details><summary>Modifier ce compte</summary><form class="stack" method="post" action="/actions/account-edit"><AntiforgeryToken /><input type="hidden" name="id" value="@a.Id" /><label>Nom<input name="name" value="@a.Name" maxlength="100" required /></label><label>Établissement<input name="institution" value="@a.Institution" maxlength="100" required /></label><button class="secondary">Enregistrer</button></form></details>
        <details class="danger-zone"><summary>Supprimer ce compte</summary><p>Possible uniquement si le compte ne contient aucune opération ni échéance.</p><form method="post" action="/actions/account-delete"><AntiforgeryToken /><input type="hidden" name="id" value="@a.Id" /><button class="danger">Supprimer définitivement</button></form></details></article>
    }
    @if (W.Accounts.Count == 0) { <section class="panel empty"><span class="empty-symbol">▤</span><h2>Tout commence ici.</h2><p>Ajoutez votre premier compte avec son solde actuel, puis saisissez uniquement les opérations suivantes.</p></section> }
    </div>
    <section class="panel form-panel" id="ajouter"><span class="eyebrow">UN NOUVEAU REPÈRE</span><h2>Ajouter un compte</h2><p class="muted">Les montants sont suivis en euros. Aucun identifiant bancaire n’est nécessaire.</p>
        <form class="form-grid" method="post" action="/actions/account-add"><AntiforgeryToken />
            <label>Nom du compte<input name="name" placeholder="Compte commun, Livret A…" maxlength="100" required /></label>
            <label>Établissement<input name="institution" placeholder="Votre banque" maxlength="100" required /></label>
            <label>Type<select name="kind"><option value="Current">Compte courant</option><option value="Savings">Épargne</option><option value="Investment">Investissement</option></select></label>
            <label>Solde de départ (€)<input name="opening" type="number" step="0.01" min="-100000000" max="100000000" value="0" required /></label>
            <label>Date du solde de départ<input name="date" type="date" value="@Iso(Today)" min="1900-01-01" max="@Iso(Today)" required /></label>
            <div class="form-actions"><button>Créer le compte ↗</button></div>
        </form>
    </section>
}
