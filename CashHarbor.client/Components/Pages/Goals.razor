@page "/objectifs"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Objectifs · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">UN PEU CHAQUE JOUR</span><h1>Faites place à vos projets<span class="accent">.</span></h1><p>Un montant, une envie et un cap à tenir ensemble.</p></div><a class="button" href="#ajouter">Nouvel objectif ↗</a></header>
<Notice />
@if (W != null)
{
    <p class="notice neutral">Un objectif lié à un compte utilise son solde enregistré actuel. Sans compte, le montant reste déclaratif. Aucun virement automatique ni rendement futur ne sont supposés.</p>
    <div class="account-grid">@foreach (var g in W.Goals)
    {
        var current = GoalPlanning.Current(W, g);
        <article class="panel"><div class="row-between"><span class="tag">@(current >= g.TargetCents ? "Cap atteint" : "En chemin")</span><span class="account-symbol">◎</span></div><h2>@g.Name</h2><span class="tag">@Visibility(g.Visibility)</span><strong class="account-balance">@Euro(current)</strong><p class="muted">sur @Euro(g.TargetCents) @(g.Deadline != null ? "· avant le " + g.Deadline.Value.ToString("dd/MM/yyyy") : "")</p><meter min="0" max="@g.TargetCents" value="@Math.Clamp(current,0,g.TargetCents)" aria-label="Progression de @g.Name"></meter><small>@((Math.Max(0,current) * 100m / g.TargetCents).ToString("0")) % du projet</small>
        @if(g.AccountId is {} linked){<p class="muted">Compte suivi : <strong>@W.Accounts.Single(a=>a.Id==linked).Name</strong> · solde mis à jour depuis vos opérations et relevés.</p>}
@if(g.Deadline is {} deadline){var months=GoalPlanning.Months(Today,deadline);var remaining=Math.Max(0,g.TargetCents-current);<div class="notice neutral">@if(remaining==0){<strong>Objectif atteint.</strong>}else if(months>0){<span>Reste à financer : <strong>@Euro(remaining)</strong><br />Effort mensuel : <strong>@Euro(GoalPlanning.Monthly(current,g.TargetCents,months)) / mois</strong> pendant @months mois.</span>}else{<span>Reste à financer : <strong>@Euro(remaining)</strong>. Échéance dépassée ou moins d’un mois disponible pour un versement mensuel.</span>}</div><p class="data-method">Sans intérêts futurs, frais ni retraits. Versements mensuels à partir du mois prochain ; dernier versement au plus tard à l’échéance. Montant arrondi au centime supérieur.</p>}
        <details><summary>Mettre à jour</summary><form class="stack" method="post" action="/actions/goal-save"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@g.Id" /><label>Compte à suivre<select name="account"><option value="">Aucun — montant saisi manuellement</option>@foreach(var account in W.Accounts){<option value="@account.Id" selected="@(g.AccountId==account.Id)">@account.Name · @Kind(account.Kind)</option>}</select><small>Le solde du compte remplace le montant manuel. Plusieurs objectifs sur un même compte suivent le même solde, sans réserver de fonds.</small></label><label>Nom<input name="name" value="@g.Name" maxlength="100" required /></label><label>Cible (€)<input type="number" name="target" min="0.01" max="100000000" step="0.01" value="@Amount(g.TargetCents)" required /></label><label>Montant manuel (€), ignoré si un compte est lié<input type="number" name="saved" min="0" max="100000000" step="0.01" value="@Amount(g.SavedCents)" required /></label><label>Échéance<input type="date" name="deadline" value="@(g.Deadline == null ? "" : Iso(g.Deadline.Value))" /></label><button>Enregistrer</button></form></details>
        <details class="danger-zone"><summary>Supprimer l’objectif</summary><form method="post" action="/actions/goal-delete"><AntiforgeryToken /><SpaceField /><input type="hidden" name="id" value="@g.Id" /><button class="danger">Confirmer la suppression</button></form></details></article>
    }
    @if (W.Goals.Count == 0) { <section class="panel empty"><span class="empty-symbol">◎</span><h2>Quel est votre prochain cap ?</h2><p>Un voyage, un apport ou une réserve pour les imprévus.</p></section> }</div>
    <section class="panel form-panel" id="ajouter"><span class="eyebrow">DE L’ENVIE AU PROJET</span><h2>Créer un objectif</h2><form class="form-grid" method="post" action="/actions/goal-save"><AntiforgeryToken /><SpaceField /><input type="hidden" name="visibility" value="@Space.Visibility" /><div><small>Destination</small><p>Espace @Space.Label.ToLowerInvariant()</p></div><label>Compte à suivre<select name="account"><option value="">Aucun — montant saisi manuellement</option>@foreach(var account in W.Accounts){<option value="@account.Id" >@account.Name · @Kind(account.Kind)</option>}</select><small>Le solde du compte remplace le montant manuel. Plusieurs objectifs sur un même compte suivent le même solde, sans réserver de fonds.</small></label><label>Nom du projet<input name="name" maxlength="100" placeholder="Notre prochain voyage…" required /></label><label>Montant cible (€)<input name="target" type="number" min="0.01" max="100000000" step="0.01" required /></label><label>Montant manuel (€), ignoré si un compte est lié<input name="saved" type="number" min="0" max="100000000" step="0.01" value="0" required /></label><label>Échéance (facultative)<input name="deadline" type="date" min="1900-01-01" /></label><div class="form-actions"><button>Créer notre objectif ↗</button></div></form></section>
}
