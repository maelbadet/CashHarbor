@page "/objectifs"
@attribute [Authorize]
@inherits FinancePage
<PageTitle>Objectifs · CashHarbor</PageTitle>
<header class="page-header"><div><span class="eyebrow">UN PEU CHAQUE JOUR</span><h1>Faites place à vos projets<span class="accent">.</span></h1><p>Un montant, une envie et un cap à tenir ensemble.</p></div><a class="button" href="#ajouter">Nouvel objectif ↗</a></header>
<Notice />
@if (W != null)
{
    <p class="notice neutral">Les montants mis de côté sont déclaratifs : ils ne déplacent pas d’argent et ne s’ajoutent pas aux soldes des comptes.</p>
    <div class="account-grid">@foreach (var g in W.Goals)
    {
        <article class="panel"><div class="row-between"><span class="tag">@(g.SavedCents >= g.TargetCents ? "Cap atteint" : "En chemin")</span><span class="account-symbol">◎</span></div><h2>@g.Name</h2><span class="tag">@Visibility(g.Visibility)</span><strong class="account-balance">@Euro(g.SavedCents)</strong><p class="muted">sur @Euro(g.TargetCents) @(g.Deadline != null ? "· avant le " + g.Deadline.Value.ToString("dd/MM/yyyy") : "")</p><meter min="0" max="@g.TargetCents" value="@g.SavedCents" aria-label="Progression de @g.Name"></meter><small>@((g.SavedCents * 100m / g.TargetCents).ToString("0")) % du projet</small>
        <details><summary>Mettre à jour</summary><form class="stack" method="post" action="/actions/goal-save"><AntiforgeryToken /><input type="hidden" name="id" value="@g.Id" /><label>Nom<input name="name" value="@g.Name" maxlength="100" required /></label><label>Cible (€)<input type="number" name="target" min="0.01" max="100000000" step="0.01" value="@Amount(g.TargetCents)" required /></label><label>Mis de côté (€)<input type="number" name="saved" min="0" max="100000000" step="0.01" value="@Amount(g.SavedCents)" required /></label><label>Échéance<input type="date" name="deadline" value="@(g.Deadline == null ? "" : Iso(g.Deadline.Value))" /></label><button>Enregistrer</button></form></details>
        <details class="danger-zone"><summary>Supprimer l’objectif</summary><form method="post" action="/actions/goal-delete"><AntiforgeryToken /><input type="hidden" name="id" value="@g.Id" /><button class="danger">Confirmer la suppression</button></form></details></article>
    }
    @if (W.Goals.Count == 0) { <section class="panel empty"><span class="empty-symbol">◎</span><h2>Quel est votre prochain cap ?</h2><p>Un voyage, un apport ou une réserve pour les imprévus.</p></section> }</div>
    <section class="panel form-panel" id="ajouter"><span class="eyebrow">DE L’ENVIE AU PROJET</span><h2>Créer un objectif</h2><form class="form-grid" method="post" action="/actions/goal-save"><AntiforgeryToken /><label>Visibilité<select name="visibility"><option value="Personal">Personnel — visible uniquement par moi</option><option value="Joint">Commun — visible par nous deux</option></select></label><label>Nom du projet<input name="name" maxlength="100" placeholder="Notre prochain voyage…" required /></label><label>Montant cible (€)<input name="target" type="number" min="0.01" max="100000000" step="0.01" required /></label><label>Déjà mis de côté (€)<input name="saved" type="number" min="0" max="100000000" step="0.01" value="0" required /></label><label>Échéance (facultative)<input name="deadline" type="date" min="1900-01-01" /></label><div class="form-actions"><button>Créer notre objectif ↗</button></div></form></section>
}
