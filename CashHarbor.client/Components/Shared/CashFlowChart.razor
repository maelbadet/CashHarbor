@{
    var report = Report ?? FinancialAnalytics.Build(Workspace, new(new DateOnly(Today.Year, Today.Month, 1).AddMonths(-5), Today), Today);
}
<FlowChart Report="report" />
@code {
    [Parameter, EditorRequired] public Workspace Workspace { get; set; } = default!;
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public AnalyticsReport? Report { get; set; }
}
