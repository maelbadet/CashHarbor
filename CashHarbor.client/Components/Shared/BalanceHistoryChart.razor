@{
    var report = Report ?? FinancialAnalytics.Build(Workspace, new(new DateOnly(Today.Year, Today.Month, 1).AddMonths(-5), Today, AccountId: AccountId), Today);
    var history = report.History.Where(p => p.TrackedAccounts > 0).ToArray();
    var series = new List<ChartSeries>();
    if (history.Length > 0)
    {
        series.Add(new(report.Accounts.Count == 1 ? report.Accounts[0].Account.Name : "Total des comptes", history.Select(p => p.TotalCents).ToArray(), "series-total"));
        if (report.Accounts.Any(p => p.Account.Visibility == AccountVisibility.Personal) && report.Accounts.Any(p => p.Account.Visibility == AccountVisibility.Joint))
        {
            series.Add(new("Personnel", history.Select(p => p.PersonalCents).ToArray(), "series-personal"));
            series.Add(new("Commun", history.Select(p => p.JointCents).ToArray(), "series-joint"));
        }
    }
}
@if (history.Length == 0)
{
    <div class="chart-empty"><span>⌁</span><strong>Aucun historique disponible</strong><p>Les soldes apparaîtront à partir de leur date de départ renseignée.</p></div>
}
else
{
    <TimeSeriesChart Dates="history.Select(p => p.Date).ToArray()" Series="series" Title="Soldes quotidiens des comptes sélectionnés" />
    <p class="data-method">Soldes en fin de journée, calculés au centime depuis vos soldes initiaux et vos opérations. Virements et valorisations sont inclus dans les soldes ; ce graphique ne mesure pas un rendement.</p>
    @if (history.Any(p => p.TrackedAccounts < p.SelectedAccounts))
    {
        <p class="coverage-note">Historique partiel avant certaines dates de départ : seuls les comptes déjà renseignés sont inclus à chaque date. L’ajout d’un solde initial peut créer un saut dans la courbe.</p>
    }
}
@code {
    [Parameter, EditorRequired] public Workspace Workspace { get; set; } = default!;
    [Parameter] public DateOnly Today { get; set; }
    [Parameter] public Guid? AccountId { get; set; }
    [Parameter] public AnalyticsReport? Report { get; set; }
}
